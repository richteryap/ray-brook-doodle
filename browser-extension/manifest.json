{
  "manifest_version": 3,
  "name": "Ray Brook Logs",
  "version": "1.1",
  "description": "Manual Media Stream Tracker (Supabase Edition)",
  "browser_specific_settings": {
    "gecko": {
      "id": "raybrook-logs@richteryap.github.io"
    }
  },
  "permissions": [
    "activeTab",
    "notifications",
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://graphql.anilist.co/*"
  ]
}